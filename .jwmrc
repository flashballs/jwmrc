</Menu>
<Menu icon="folder.png" label="System">
    <Menu icon="folder.png" label="Settings">
        <Program label="Openbox Configuration Manager">obconf</Program>
        <Program label="Setup Hot Keys">lxhotkey --gui=gtk</Program>
        <Program label="Tint2 Settings">tint2conf</Program>
        <Program label="WPrefs">WPrefs</Program>
    </Menu>
    <Program label="chronyc">st -e chronyc</Program>
    <Program label="Htop">st -e htop</Program>
    <Program label="pstree">st -e pstree</Program>
