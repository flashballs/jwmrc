</Menu>
<Menu icon="folder.png" label="Other">
    <Program label="windowmaker">wmaker</Program>
</Menu>
<Menu icon="folder.png" label="Science">
    <Program label="bc">st -e bc</Program>
    <Program label="dc">st -e dc</Program>
</Menu>
<Menu icon="folder.png" label="Shells">
    <Program label="GIT">st -e git</Program>
