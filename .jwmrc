<?xml version="1.0"?>
<JWM>
<Include>jwm-generated-menu</Include>


    <!-- Options for program groups. -->
    <Group>
        <Option>tiled</Option>
        <Option>aerosnap</Option>
    </Group>
    <Group>
        <Class>Pidgin</Class>
        <Option>sticky</Option>
    </Group>
    <Group>
        <Name>xterm</Name>
        <Option>vmax</Option>
r   </Group>
    <Group>
        <Name>xclock</Name>
        <Option>drag</Option>
        <Option>notitle</Option>
    </Group>

    <!-- Tray at the bottom. -->
    <Tray x="0" y="-1" autohide="off" valign="top" height="35">

        <TrayButton icon="jwm-blue">root:1</TrayButton>
        <Spacer width="2"/>
        <TrayButton label="_">showdesktop</TrayButton>
        <Spacer width="2"/>

        <Pager labeled="true"/>

        <TaskList maxwidth="256"/>

        <Dock/>
        <Clock format="%I:%M"><Button mask="123">exec:xclock</Button></Clock>

    </Tray>

    <!-- Visual Styles -->
    <WindowStyle decorations="motif">
	<Font>Hack Nerd Font-14:mono</Font>
        <Width>7</Width>
        <Height>25</Height>
        <Corner>0</Corner>
        <Foreground>#3B4252</Foreground>
        <Background>#3B4252</Background>
        <Outline>#4c566a</Outline>
        <Opacity>1.0</Opacity>
        <Active>
            <Foreground>#D8DEE9</Foreground>
            <Background>#3B4252</Background>
            <Outline>#4c566a</Outline>
            <Opacity>1.0</Opacity>
        </Active>
    </WindowStyle>
    <TrayStyle group="true" list="all" decorations="motif">
        <Font>Hack Nerd Font-14:mono</Font>
        <Background>#2E3440</Background>
        <Foreground>#D8DEE9</Foreground>
        <Outline>#4c566a</Outline>
        <Opacity>1.0</Opacity>
    </TrayStyle>
    <TaskListStyle decorations="motif">
      <Font>Hack Nerd Font-14:mono</Font>
      <Active>
        <Foreground>#D8DEE9</Foreground>
        <Background>#4c566a</Background>
      </Active>
      <Foreground>#D8DEE9</Foreground>
      <Background>#2E3440</Background>
    </TaskListStyle>
    <PagerStyle decorations="motif">
        <Outline>#4c566a</Outline>
        <Foreground>#D8DEE9</Foreground>
        <Background>#2E3440</Background>
        <Text>#D8DEE9</Text>
        <Active>
            <Foreground>#D8DEE9</Foreground>
            <Background>#4c566a</Background>
        </Active>
    </PagerStyle>
    <MenuStyle decorations="motif">
        <Font>Hack Nerd Font-14:mono</Font>
        <Foreground>#D8DEE9</Foreground>
        <Background>#2E3440</Background>
        <Outline>#4c566a</Outline>
        <Active>
            <Foreground>#D8DEE9</Foreground>
            <Background>#4c566a</Background>
        </Active>
        <Opacity>1.0</Opacity>
    </MenuStyle>
    <PopupStyle>
        <Font>Hack Nerd Font-13:mono</Font>
        <Foreground>#000000</Foreground>
        <Background>#999999</Background>
    </PopupStyle>

    <!-- Path where icons can be found.
         IconPath can be listed multiple times to allow searching
         for icons in multiple paths.
      -->
    <IconPath>
        /usr/share/icons/wm-icons/32x32-aquafusion
    </IconPath>
    <IconPath>
        /usr/local/share/jwm
    </IconPath>
    <IconPath>
        /usr/share/jwm
    </IconPath>

    <!-- Virtual Desktops -->
    <!-- Desktop tags can be contained within Desktops for desktop names. -->
    <Desktops width="4" height="1">
        <!-- Default background. Note that a Background tag can be
              contained within a Desktop tag to give a specific background
              for that desktop.
         -->
        <Background type="command">xsetroot -mod 16 16 -bg '#2e3440' -fg '#4c566a'</Background>
    </Desktops>

    <!-- Double click speed (in milliseconds) -->
    <DoubleClickSpeed>400</DoubleClickSpeed>

    <!-- Double click delta (in pixels) -->
    <DoubleClickDelta>2</DoubleClickDelta>

    <!-- The focus model (sloppy or click) -->
    <FocusModel>sloppy</FocusModel>

    <!-- The snap mode (none, screen, or border) -->
    <SnapMode distance="10">border</SnapMode>

    <!-- The move mode (outline or opaque) -->
    <MoveMode>opaque</MoveMode>

    <!-- The resize mode (outline or opaque) -->
    <ResizeMode>opaque</ResizeMode>

    <!-- Key bindings -->
    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Right">right</Key>
    <Key key="Left">left</Key>
    <Key key="h">left</Key>
    <Key key="j">down</Key>
    <Key key="k">up</Key>
    <Key key="l">right</Key>
    <Key key="Return">select</Key>
    <Key key="Escape">escape</Key>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="4" key="q">close</Key>
    <Key mask="A" key="#">desktop#</Key>
    <Key mask="4" key="r">root:1</Key>
    <Key mask="A" key="F2">window</Key>
    <Key mask="4" key="m">maximize</Key>
    <Key mask="4" key="u">fullscreen</Key>
    <Key mask="A" key="Right">rdesktop</Key>
    <Key mask="A" key="Left">ldesktop</Key>
    <Key mask="A" key="Up">udesktop</Key>
    <Key mask="A" key="Down">ddesktop</Key>
    <Key mask="4S" key="q">exit</Key>
    <Key mask="4S" key="r">restart</Key>


    <Key mask="4" key="t">exec:st</Key>
    <Key mask="4" key="f">exec:firefox-bin</Key>
    <Key mask="4" key="e">exec:st -e mc</Key>
    <Key mask="4S" key="e">exec:xfe</Key>
    <Key mask="4S" key="f">exec:firefox-bin --private-window</Key>
    <Key mask="4S" key="s">exec:steam</Key>
   

   <Key mask="4" key="s">exec:scrot</Key>
   <Key key="XF86MonBrightnessUp">exec:brightnessctl set +5%</Key>
   <Key key="XF86MonBrightnessDown">exec:brightnessctl set 5%-</Key>
   <Key key="XF86AudioRaiseVolume">exec:pactl set-sink-volume @DEFAULT_SINK@ +5%</Key>
   <Key key="XF86AudioLowerVolume">exec:pactl set-sink-volume @DEFAULT_SINK@ -5%</Key>
   <Key key="XF86AudioMute">exec:pactl set-sink-mute @DEFAULT_SINK@ toggle</Key>

<Key mask="4" key="m">exec:~/jwmrc/.genjwmmenu.sh</Key>


<!-- startup commands -->

<StartupCommand>
cbatticon 
</StartupCommand>





</JWM>
